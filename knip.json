{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/web": {
      "project": [
        "src/**/*.{ts,tsx}",
        "e2e/**/*.ts"
      ],
      "entry": [
        "scripts/*.mjs"
      ]
    },
    "apps/server": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/widget-sdk": {
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
