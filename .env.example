# 个人工作台（all-in-one）环境变量样例
#
# 用法：复制为 .env 供 docker compose 读取（compose 会做变量替换），
# 或直接 export 到 shell 后 `pnpm dev` / 裸跑 server。
#
#   cp .env.example .env
#
# ⚠️ .env 已在 .gitignore 中，任何真实凭证都不要提交进仓库。

# ── 首启必填（D17）─────────────────────────────────────────────
# 初始账号口令（仅首次启动创建账号时读取；账号已存在后不再需要）
ADMIN_PASSWORD=

# 初始用户名（可选，默认 admin）
#ADMIN_USERNAME=admin

# ── 凭证加密（必填）───────────────────────────────────────────
# AES-256-GCM 主密钥，base64 解码后恰 32 字节。生成一行命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ 丢失即已存第三方凭证永久无法解密，请与 ./data 备份分开保存
CREDENTIALS_MASTER_KEY=

# ── 部署相关 ─────────────────────────────────────────────────
# 公网 / HTTPS 部署必须置 1（会话 cookie 带 Secure，防明文截获）
#COOKIE_SECURE=0

# custom-api / 邮件组件以本机或内网服务为目标时置 1。
# 出站默认拒绝内网目标（SSRF 基线）；应用入口探活、iframe 禁嵌检测不受影响。
#ALLOW_PRIVATE_OUTBOUND=0

# 日志级别 debug|info|warn|error（password/secret/token/cookie 自动 [REDACTED]）
#LOG_LEVEL=info

# ── Gmail 接入（可选，见 docs/deploy.md「接入 Gmail」）──────────
#GMAIL_CLIENT_ID=
#GMAIL_CLIENT_SECRET=

# ── 高级：Docker 镜像内已固定，仅裸跑 server 时需要 ─────────────
# 数据库位置。数据目录 = DB 所在目录（./data 里还有插件与自定义 CSS）。
# 注意：没有 DATA_DIR 这个变量，设了也不生效。
#DATABASE_URL=file:./data/app.db
# 监听地址与端口（镜像内 HOST=0.0.0.0；本地开发默认 127.0.0.1:3000）
#HOST=127.0.0.1
#PORT=3000
# 前端静态资源目录（不设则为纯 API 模式，不伺服前端）
#PUBLIC_DIR=
