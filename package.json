{
  "name": "all-in-one",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm run --parallel --filter \"@all-in-one/*\" --if-present dev",
    "dev:web": "pnpm --filter @all-in-one/web dev",
    "dev:server": "pnpm --filter @all-in-one/server dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && knip",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "knip": "knip"
  },
  "devDependencies": {
    "knip": "^6.39.0"
  }
}
